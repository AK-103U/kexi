---
import { getBylineBySlug, getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import SiteRail from "../components/SiteRail.astro";
import { type Lang } from "../i18n/config";
import { htmlLang, localePath, useTranslations } from "../i18n/ui";
import { OWNER_BYLINE_SLUG, resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	/** 当前页面的语言。所有公开页面必须显式传入。 */
	lang: Lang;
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	lang,
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const t = useTranslations(lang);
const [settingsResult, menuResult, ownerByline] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary", { locale: lang }),
	// 左栏的站主身份。走 locale fallback 链，中英各取各的 displayName。
	getBylineBySlug(OWNER_BYLINE_SLUG, { locale: lang }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle } = resolveBlogSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;

const menu = menuResult.data;

// 实时搜索结果链接默认拼成 /{collection}/{slug}，不带语言前缀。
// 在非默认语言下必须显式给出带前缀的路由模板。
const searchRouteMap = {
	posts: localePath(lang, "/posts/:slug"),
	pages: localePath(lang, "/pages/:slug"),
};

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang={htmlLang(lang)}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		{/*
			客户端接管站内导航（含语言切换）：不再整页刷新，且带过渡动画。
			底层仍是 MPA —— 首屏 SSR、SEO、hreflang、RSS 全部保留。
		*/}
		<ClientRouter />
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var row = document.cookie.split("; ").find(function (item) {
					return item.startsWith("theme=");
				});
				var theme = row ? row.slice(6) : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<header class="site-header">
			<nav class="nav">
				<button
					type="button"
					class="nav-burger"
					data-nav-toggle
					aria-expanded="false"
					aria-controls="nav-drawer"
					aria-label={t("header.openMenu")}
				>
					<svg
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<line x1="4" y1="6" x2="20" y2="6"></line>
						<line x1="4" y1="12" x2="20" y2="12"></line>
						<line x1="4" y1="18" x2="20" y2="18"></line>
					</svg>
				</button>
				<div class="nav-right">
					<LiveSearch
						placeholder={t("header.searchPlaceholder")}
						locale={lang}
						class="site-search"
						inputClass="site-search-input"
						resultsClass="site-search-results"
						resultClass="site-search-result"
						collections={["posts", "pages"]}
						routeMap={searchRouteMap}
						searchPage={localePath(lang, "/search")}
					/>
					<div class="nav-toggles">
						<LanguageSwitcher lang={lang} />
						<ThemeSwitcher lang={lang} />
					</div>
				</div>
				{
					isLoggedIn && (
						<a href="/_emdash/admin" class="nav-admin">
							{t("header.admin")}
						</a>
					)
				}
			</nav>

			{/* 窄屏导航抽屉：与左栏同一份菜单，但**不含**头像与名字。 */}
			<div class="nav-drawer" id="nav-drawer" data-nav-drawer hidden>
				<ul class="nav-drawer-list">
					{
						menu?.items.map((item) => (
							<li>
								<a
									href={item.url}
									target={item.target}
									rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</header>

		{/*
			文档式三栏外壳：左栏（站主 + 导航）／中栏（正文）／右栏（目录）。
			右栏的槽在非文章页是空的 —— 轨道照样占位，中栏位置全站恒定不跳。
		*/}
		<div class="shell">
			<aside class="rail rail--left">
				{
					ownerByline && (
						<SiteRail
							displayName={ownerByline.displayName}
							avatarStorageKey={ownerByline.avatarStorageKey}
							avatarAlt={ownerByline.avatarAlt}
							items={menu?.items ?? []}
							pathname={Astro.url.pathname}
						/>
					)
				}
			</aside>

			<main class="shell-main">
				<slot />
			</main>

			<aside class="rail rail--right">
				<slot name="rail" />
			</aside>
		</div>

		<footer class="site-footer">
			<div class="footer-bottom">
				<p class="footer-copyright" set:html={t("footer.poweredBy")} />
				<a
					class="footer-rss"
					href={localePath(lang, "/rss.xml")}
					aria-label={t("footer.rss")}
					title={t("footer.rss")}
				>
					<svg
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<path d="M4 11a9 9 0 0 1 9 9"></path>
						<path d="M4 4a16 16 0 0 1 16 16"></path>
						<circle cx="5" cy="19" r="1"></circle>
					</svg>
				</a>
			</div>
		</footer>

		<script>
			// Theme switcher
			//
			// ClientRouter 下这个模块脚本只在首次加载执行一次，而页面切换后
			// <html> 的 class 会被重置、按钮也换成了新节点，所以每次导航都要
			// 重跑一次初始化 —— 用 astro:page-load 驱动（首次加载与每次客户端
			// 导航后都会触发）。监听器用 onclick 赋值而非 addEventListener，
			// 重复执行也不会叠加。
			function getStoredTheme(): string {
				const row = document.cookie
					.split("; ")
					.find((item) => item.startsWith("theme="));
				return row?.slice(6) || "system";
			}

			function setCookie(
				name: string,
				value: string,
				maxAge: number = 31536000,
			) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
				}
			}

			// 没有 cookie 时跟随系统，所以「此刻生效的是哪个主题」得问一下媒体查询。
			function effectiveTheme(): "light" | "dark" {
				const stored = getStoredTheme();
				if (stored === "light" || stored === "dark") return stored;
				return window.matchMedia("(prefers-color-scheme: dark)").matches
					? "dark"
					: "light";
			}

			function setupTheme() {
				const btn = document.querySelector<HTMLButtonElement>(".theme-btn");
				if (!btn) return;
				const root = document.documentElement;
				const lightLabel = btn.dataset.labelLight ?? "";
				const darkLabel = btn.dataset.labelDark ?? "";

				// 按钮说的是「点了会切到哪」，所以文案指向的是另一个主题。
				function sync() {
					const label = effectiveTheme() === "dark" ? lightLabel : darkLabel;
					btn!.setAttribute("aria-label", label);
					btn!.title = label;
				}

				btn.onclick = () => {
					const next = effectiveTheme() === "dark" ? "light" : "dark";
					setCookie("theme", next);
					root.classList.remove("light", "dark");
					root.classList.add(next);
					sync();
				};

				// 跟随系统时，系统主题变了图标也得跟着换（onchange 赋值，不叠加）。
				window.matchMedia("(prefers-color-scheme: dark)").onchange = () => {
					if (getStoredTheme() === "system") sync();
				};

				sync();
			}

			setupTheme();
			document.addEventListener("astro:page-load", setupTheme);

			// 换页时先给新文档的 <html> 补上主题 class，避免过渡期间闪一下。
			document.addEventListener("astro:before-swap", (event) => {
				const theme = getStoredTheme();
				if (theme === "light" || theme === "dark") {
					event.newDocument.documentElement.classList.add(theme);
				}
			});
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/tokens.css. Colors are
				 * defined with light-dark(); these rules pin the scheme when
				 * the footer switcher sets an explicit choice. With no class,
				 * color-scheme: light dark follows the OS preference. The
				 * @supports guard keeps the toggle from forcing dark UA form
				 * controls on browsers stuck on the plain-light fallback.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
					/*
					 * 恒定预留滚动条槽位。否则「一屏装得下的页面」（如 /pages/about）
					 * 没有滚动条、clientWidth 比长页面宽 15px，居中的外壳会整体横移 ——
					 * 客户端导航过去时肉眼可见地漂一下。
					 */
					scrollbar-gutter: stable;
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-relaxed);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
					min-height: 100vh;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: var(--color-brand);
					text-decoration: none;
					transition: color var(--transition-fast);
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
					color: var(--color-brand-hover);
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					line-height: var(--leading-tight);
					font-weight: var(--font-weight-heading);
					letter-spacing: var(--tracking-snug);
				}

				h1 {
					font-weight: var(--font-weight-display);
					letter-spacing: var(--tracking-tight);
				}

				::selection {
					background: var(--color-brand);
					color: var(--color-on-brand);
				}
			}
		</style>

		<style>
			.site-header {
				position: sticky;
				top: 0;
				z-index: 100;
				background: color-mix(in srgb, var(--color-bg) 65%, transparent);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border-bottom: 1px solid var(--color-border-subtle);
			}

			.nav {
				display: grid;
				/*
				 * 左右两列等宽（minmax(0,1fr)），中间按内容宽 —— 中列因此恒定
				 * 落在页面中垂线上，与两侧有没有东西（汉堡、管理链接）无关。
				 * 用 minmax(0,…) 而不是裸 1fr：裸 1fr 的下限是 min-content，
				 * 侧边内容一宽就会把中列挤偏。
				 */
				grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
				align-items: center;
				gap: var(--spacing-4);
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-4) var(--spacing-6);
				height: var(--nav-height);
			}

			/* 汉堡按钮：只在 <1000px 出现（左栏隐藏时）。 */
			.nav-burger {
				display: none;
				grid-column: 1;
				justify-self: start;
				align-items: center;
				justify-content: center;
				padding: var(--spacing-1);
				background: none;
				border: none;
				color: var(--color-text);
				cursor: pointer;
				border-radius: var(--radius);
			}

			.nav-burger svg {
				width: 22px;
				height: 22px;
			}

			.nav-burger:hover {
				color: var(--color-brand);
			}

			/* 抽屉：与左栏同一份菜单。 */
			.nav-drawer {
				border-top: 1px solid var(--color-border-subtle);
				background: var(--color-bg);
			}

			.nav-drawer-list {
				list-style: none;
				display: flex;
				flex-direction: column;
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-3) var(--spacing-6) var(--spacing-4);
			}

			.nav-drawer-list a {
				display: block;
				padding: var(--spacing-2) 0;
				font-size: var(--font-size-base);
				color: var(--color-text);
				text-decoration: none;
			}

			.nav-drawer-list a:hover {
				color: var(--color-brand);
			}

			/*
			 * 三栏外壳。宽度账（含滚动条槽位）：
			 * 200 + 24 + 680 + 24 + 200 = 1128，加两侧 padding 48 = 1176，
			 * 加滚动条 ≈ 1193 → 断点取 1200。
			 */
			.shell {
				display: grid;
				grid-template-columns:
					var(--rail-width) minmax(0, var(--content-width))
					var(--rail-width);
				gap: var(--spacing-6);
				justify-content: center;
				/* 必须 start：stretch 会让 rail 撑满行高，sticky 就没有可滚动的余量 */
				align-items: start;
				/*
				 * rail 的静止位 = 页头高度 + 这里的上边距，而 .rail 的 sticky top
				 * 必须与之相等 —— 否则在滚动状态下切页（scrollY 归零）时，rail 会
				 * 从 sticky 位弹回静止位，那 17px 的跳动每次导航都看得见。
				 * 两个值都从 --shell-pad-top 推出来，改一处即可。
				 */
				--shell-pad-top: var(--spacing-12);
				/* +1px 是 .site-header 的下边框 */
				--rail-sticky-top: calc(var(--nav-height) + 1px + var(--shell-pad-top));
				padding: var(--shell-pad-top) var(--spacing-6) var(--spacing-16);
			}

			.rail {
				align-self: start;
				position: sticky;
				top: var(--rail-sticky-top);
			}

			.shell-main {
				min-width: 0;
			}

			.nav-right {
				grid-column: 2;
				display: flex;
				align-items: center;
				gap: var(--spacing-6);
			}

			/* 语言与主题切换挨在一起，任何断点下都并排。 */
			.nav-toggles {
				display: flex;
				align-items: center;
				gap: var(--spacing-2);
			}

			.nav-admin {
				grid-column: 3;
				justify-self: end;
				font-size: var(--font-size-sm);
				color: var(--color-text-secondary);
				text-decoration: none;
				transition: color var(--transition-fast);
			}

			.nav-admin:hover {
				color: var(--color-text);
			}

			/*
			 * Search styling。
			 * `.site-search` 是传给 LiveSearch 的 class，节点上带的是**子组件的**
			 * scope 属性，所以这里必须用 :global() —— 否则规则一条都不生效
			 * （搜索结果下拉的定位就靠这里的 position: relative）。
			 */
			:global(.site-search) {
				position: relative;
				width: var(--search-input-width);
				--emdash-search-border-focus: var(--color-brand);
			}

			:global(.site-search-input) {
				width: var(--search-input-width);
				padding: var(--spacing-2) var(--spacing-3);
				font-family: var(--font-body);
				font-size: var(--font-size-sm);
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				background: var(--color-bg);
				color: var(--color-text);
				transition:
					border-color var(--transition-fast),
					box-shadow var(--transition-fast);
			}

			:global(.site-search-input)::placeholder {
				color: var(--color-muted);
			}

			:global(.site-search-input):focus,
			:global(.site-search-input):focus-visible {
				outline: none;
				border-color: var(--color-brand) !important;
				box-shadow: 0 0 0 3px var(--color-brand-ring);
			}

			:global(.site-search-results) {
				position: absolute;
				top: 100%;
				left: 0;
				right: 0;
				margin-top: var(--spacing-2);
				background: var(--color-bg);
				border: 1px solid var(--color-border);
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-lg);
				max-height: 400px;
				overflow-y: auto;
				z-index: 1000;
			}

			:global(.site-search-results .emdash-live-search-loading),
			:global(.site-search-results .emdash-live-search-no-results) {
				padding: var(--spacing-4);
				text-align: center;
				color: var(--color-muted);
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result) {
				display: block;
				padding: var(--spacing-3) var(--spacing-4);
				text-decoration: none;
				color: var(--color-text);
				border-bottom: 1px solid var(--color-border-subtle);
				transition: background var(--transition-fast);
			}

			:global(.site-search-result):last-child {
				border-bottom: none;
			}

			:global(.site-search-result):hover,
			:global(.site-search-result):focus,
			:global(.site-search-result.focused) {
				background: var(--color-surface);
				outline: none;
			}

			:global(.site-search-result .emdash-live-search-result-title) {
				display: block;
				font-weight: 500;
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result .emdash-live-search-result-collection) {
				display: block;
				font-size: var(--font-size-xs);
				color: var(--color-muted);
				text-transform: uppercase;
				letter-spacing: var(--tracking-wide);
				margin-top: 2px;
			}

			:global(.site-search-result .emdash-live-search-result-snippet) {
				display: block;
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				margin-top: var(--spacing-1);
				line-height: var(--leading-snug);
			}

			:global(.site-search-result .emdash-live-search-result-snippet mark) {
				font-weight: 600;
				color: var(--color-text);
			}

			main {
				min-height: calc(100vh - var(--nav-height) - 300px);
			}
			/* Footer */
			.site-footer {
				background: var(--color-bg-subtle);
				border-top: 1px solid var(--color-border-subtle);
			}

			/* 页脚就一行：版权 + RSS，高度贴着内容走。 */
			.footer-bottom {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: var(--spacing-3);
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-3) var(--spacing-6);
			}

			.footer-copyright {
				font-size: var(--font-size-sm);
				color: var(--color-muted);
			}

			.footer-copyright a {
				color: var(--color-text-secondary);
			}

			.footer-rss {
				display: inline-flex;
				align-items: center;
				color: var(--color-muted);
				transition: color var(--transition-fast);
			}

			.footer-rss:hover {
				color: var(--color-brand);
			}

			.footer-rss svg {
				width: 16px;
				height: 16px;
			}

			/*
			 * 三栏 → 两栏：视口装不下 200+680+200+gap+padding 时先收右栏。
			 * 左栏还在，中栏位置不变 —— 这正是「右栏留空不渲染」的延伸。
			 */
			@media (max-width: 1199px) {
				.shell {
					grid-template-columns: var(--rail-width) minmax(0, var(--content-width));
				}

				.rail--right {
					display: none;
				}
			}

			/* 两栏也装不下 → 单栏，左栏收进页头的汉堡抽屉。 */
			@media (max-width: 999px) {
				.shell {
					grid-template-columns: minmax(0, var(--content-width));
					/* 只改 --shell-pad-top，rail 的 sticky 位跟着走，不会脱节 */
					--shell-pad-top: var(--spacing-8);
					padding: var(--shell-pad-top) var(--spacing-4) var(--spacing-12);
				}

				.rail--left {
					display: none;
				}

				.nav-burger {
					display: inline-flex;
				}
			}

			@media (max-width: 640px) {
				.nav {
					display: grid;
					grid-template-columns: auto minmax(0, 1fr) auto;
					align-items: center;
					height: auto;
					column-gap: var(--spacing-3);
					padding: var(--spacing-3) var(--spacing-4);
				}

				.nav-burger {
					grid-column: 1;
					grid-row: 1;
				}

				/* 移动端：搜索框占满剩余宽度，不再追求中垂线居中。 */
				.nav-right {
					grid-column: 2;
					grid-row: 1;
					display: flex;
					align-items: center;
					gap: var(--spacing-3);
				}

				:global(.site-search) {
					flex: 1;
					min-width: 0;
					width: auto;
					max-width: none;
				}

				:global(.site-search-input) {
					width: 100% !important;
					padding: var(--spacing-1) var(--spacing-2) !important;
					font-size: var(--font-size-sm) !important;
				}

				.nav-admin {
					grid-column: 3;
					grid-row: 1;
					justify-self: end;
					font-size: var(--font-size-xs);
					white-space: nowrap;
				}
			}
		</style>

		<script>
			// ⌘K / Ctrl+K to focus search
			document.addEventListener("keydown", (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key === "k") {
					e.preventDefault();
					const searchInput = document.querySelector(
						".site-search-input",
					) as HTMLInputElement;
					if (searchInput) {
						searchInput.focus();
					}
				}
			});

			// 窄屏导航抽屉。与主题切换同一套 ClientRouter 规矩：
			// 每次导航后按钮是新节点，所以要在 astro:page-load 重绑，
			// 且用 onclick 赋值（不是 addEventListener）避免监听器叠加。
			function setupNavDrawer() {
				const btn = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
				const drawer = document.querySelector<HTMLElement>("[data-nav-drawer]");
				if (!btn || !drawer) return;

				const setOpen = (open: boolean) => {
					drawer.hidden = !open;
					btn.setAttribute("aria-expanded", String(open));
				};

				setOpen(false);
				btn.onclick = () => setOpen(drawer.hasAttribute("hidden"));
			}

			setupNavDrawer();
			document.addEventListener("astro:page-load", setupNavDrawer);
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
