---
import { getBylineBySlug, getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import SiteIdentity from "../components/SiteIdentity.astro";
import SiteRail from "../components/SiteRail.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SocialLinks from "../components/SocialLinks.astro";
import BackToTop from "../components/BackToTop.astro";
import { type Lang } from "../i18n/config";
import { htmlLang, localePath, useTranslations } from "../i18n/ui";
import { OWNER_BYLINE_SLUG, resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	/** 当前页面的语言。所有公开页面必须显式传入。 */
	lang: Lang;
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	lang,
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const t = useTranslations(lang);
const [settingsResult, menuResult, footerMenuResult, ownerByline] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary", { locale: lang }),
	getMenuWithCacheHint("footer", { locale: lang }),
	// 左栏的站主身份。走 locale fallback 链，中英各取各的 displayName。
	getBylineBySlug(OWNER_BYLINE_SLUG, { locale: lang }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	Astro.cache.set(footerMenuResult.cacheHint);
}

const { siteTitle } = resolveBlogSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;

const menu = menuResult.data;
const footerMenu = footerMenuResult.data;

// 实时搜索结果链接默认拼成 /{collection}/{slug}，不带语言前缀。
// 在非默认语言下必须显式给出带前缀的路由模板。
const searchRouteMap = {
	posts: localePath(lang, "/posts/:slug"),
	pages: localePath(lang, "/pages/:slug"),
};

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang={htmlLang(lang)}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		{lang === "zh" ? (
			<Font cssVariable="--font-lato" preload />
		) : (
			<Font cssVariable="--font-body" preload />
		)}
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<link rel="icon" type="image/webp" href={settingsResult.data.favicon?.url ?? "/logo.webp"} />
		<EmDashHead page={pageCtx} />
		{/*
			客户端接管站内导航（含语言切换）：不再整页刷新，且带过渡动画。
			底层仍是 MPA —— 首屏 SSR、SEO、hreflang、RSS 全部保留。
		*/}
		<ClientRouter />
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var row = document.cookie.split("; ").find(function (item) {
					return item.startsWith("theme=");
				});
				var theme = row ? row.slice(6) : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		{/*
			文档式三栏外壳：左栏（身份 + 导航 + 工具 + 搜索）／中栏（正文）／右栏（目录）。
			右栏的槽在非文章页是空的 —— 轨道照样占位，中栏位置全站恒定不跳。

			左栏是全站唯一的导航入口，控件也只有**一份标记**：桌面侧栏分成身份/外观、主导航和底部链接；
			<1000px 同一份导航变成贴顶横栏，身份、搜索、语言/主题和汉堡同排，页脚链接位于展开菜单底部。
		*/}
		<div class="shell">
			<aside class="rail rail--left" data-reading-fade={type === "article" ? "true" : undefined}>
				<div class="rail-top">
					{/* 署名缺失时名字回退到站点标题，头像回退到默认图。 */}
					<div class="rail-identity">
						<SiteIdentity
							displayName={ownerByline?.displayName ?? siteTitle}
							avatarStorageKey={ownerByline?.avatarStorageKey}
							avatarAlt={ownerByline?.avatarAlt}
							href={localePath(lang, "/")}
						/>
						<SocialLinks
							lang={lang}
							social={settingsResult.data.social}
							class="rail-identity-socials"
						/>
					</div>
					<div class="rail-tools" role="group" aria-label={t("header.sitePreferences")}>
						<LanguageSwitcher lang={lang} />
						<ThemeSwitcher lang={lang} />
					</div>
				</div>

				{/* 汉堡：只在 <1000px 出现，控制下面的折叠菜单。 */}
				<button
					type="button"
					class="nav-burger"
					data-nav-toggle
					data-label-open={t("header.openMenu")}
					data-label-close={t("header.closeMenu")}
					aria-expanded="false"
					aria-controls="rail-menu"
					aria-label={t("header.openMenu")}
				>
					<svg
						class="nav-burger-icon nav-burger-icon--menu"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<line x1="4" y1="6" x2="20" y2="6"></line>
						<line x1="4" y1="12" x2="20" y2="12"></line>
						<line x1="4" y1="18" x2="20" y2="18"></line>
					</svg>
					<svg
						class="nav-burger-icon nav-burger-icon--close"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<line x1="6" y1="6" x2="18" y2="18"></line>
						<line x1="18" y1="6" x2="6" y2="18"></line>
					</svg>
				</button>

				{/* 菜单桌面纵排；窄屏折叠在顶部栏下方。 */}
				<div class="rail-menu" id="rail-menu">
					<SiteRail items={menu?.items ?? []} pathname={Astro.url.pathname} />
					{
						isLoggedIn && (
							<a href="/_emdash/admin" class="nav-admin">
								{t("header.admin")}
							</a>
						)
					}
					<SiteFooter
						lang={lang}
						items={footerMenu?.items ?? []}
						social={settingsResult.data.social}
					/>
				</div>

				<div class="rail-bottom">
					<div class="rail-search">
						<LiveSearch
							placeholder={t("header.searchPlaceholder")}
							locale={lang}
							class="site-search"
							inputClass="site-search-input"
							resultsClass="site-search-results"
							resultClass="site-search-result"
							collections={["posts", "pages"]}
							routeMap={searchRouteMap}
							searchPage={localePath(lang, "/search")}
						/>
					</div>
				</div>
			</aside>

			<main class="shell-main">
				<slot />
			</main>

			<aside class="rail rail--right">
				<slot name="rail" />
			</aside>
		</div>

		<BackToTop lang={lang} />


		<script>
			// Theme switcher
			//
			// ClientRouter 下这个模块脚本只在首次加载执行一次，而页面切换后
			// <html> 的 class 会被重置、按钮也换成了新节点，所以每次导航都要
			// 重跑一次初始化 —— 用 astro:page-load 驱动（首次加载与每次客户端
			// 导航后都会触发）。监听器用 onclick 赋值而非 addEventListener，
			// 重复执行也不会叠加。
			function getStoredTheme(): string {
				const row = document.cookie
					.split("; ")
					.find((item) => item.startsWith("theme="));
				return row?.slice(6) || "system";
			}

			function setCookie(
				name: string,
				value: string,
				maxAge: number = 31536000,
			) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
				}
			}

			// 没有 cookie 时跟随系统，所以「此刻生效的是哪个主题」得问一下媒体查询。
			function effectiveTheme(): "light" | "dark" {
				const stored = getStoredTheme();
				if (stored === "light" || stored === "dark") return stored;
				return window.matchMedia("(prefers-color-scheme: dark)").matches
					? "dark"
					: "light";
			}

			function setupTheme() {
				const btn = document.querySelector<HTMLButtonElement>(".theme-btn");
				if (!btn) return;
				const root = document.documentElement;
				const lightLabel = btn.dataset.labelLight ?? "";
				const darkLabel = btn.dataset.labelDark ?? "";

				// 按钮说的是「点了会切到哪」，所以文案指向的是另一个主题。
				function sync() {
					const label = effectiveTheme() === "dark" ? lightLabel : darkLabel;
					btn!.setAttribute("aria-label", label);
					btn!.title = label;
				}

				btn.onclick = () => {
					const next = effectiveTheme() === "dark" ? "light" : "dark";
					setCookie("theme", next);
					root.classList.remove("light", "dark");
					root.classList.add(next);
					sync();
				};

				// 跟随系统时，系统主题变了图标也得跟着换（onchange 赋值，不叠加）。
				window.matchMedia("(prefers-color-scheme: dark)").onchange = () => {
					if (getStoredTheme() === "system") sync();
				};

				sync();
			}

			setupTheme();
			document.addEventListener("astro:page-load", setupTheme);

			// 换页时先给新文档的 <html> 补上主题 class，避免过渡期间闪一下。
			document.addEventListener("astro:before-swap", (event) => {
				const theme = getStoredTheme();
				if (theme === "light" || theme === "dark") {
					event.newDocument.documentElement.classList.add(theme);
				}
			});
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/tokens.css. Colors are
				 * defined with light-dark(); these rules pin the scheme when
				 * the footer switcher sets an explicit choice. With no class,
				 * color-scheme: light dark follows the OS preference. The
				 * @supports guard keeps the toggle from forcing dark UA form
				 * controls on browsers stuck on the plain-light fallback.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
					/*
					 * 恒定预留滚动条槽位。否则「一屏装得下的页面」（如 /pages/about）
					 * 没有滚动条、clientWidth 比长页面宽 15px，居中的外壳会整体横移 ——
					 * 客户端导航过去时肉眼可见地漂一下。
					 */
					scrollbar-gutter: stable;
				}

				/* 页面外壳按列排列；最小高度不用于把左栏页脚推到视口底部。 */
				body {
					display: flex;
					flex-direction: column;
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-relaxed);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
					min-height: 100vh;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: var(--color-brand);
					text-decoration: none;
					transition: color var(--transition-fast);
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
					color: var(--color-brand-hover);
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					line-height: var(--leading-tight);
					font-weight: var(--font-weight-heading);
					letter-spacing: var(--tracking-snug);
				}

				h1 {
					font-weight: var(--font-weight-display);
					letter-spacing: var(--tracking-tight);
				}

				::selection {
					background: var(--color-brand);
					color: var(--color-on-brand);
				}
			}
		</style>

		<style>
			/* 桌面侧栏：品牌与外观在顶部，导航独立成组，工具落在底部。 */
			.rail--left {
				z-index: 100;
				display: flex;
				flex-direction: column;
				align-items: stretch;
				gap: var(--spacing-4);
				padding-right: var(--spacing-2);
				border-right: 1px solid var(--color-border-subtle);
				background: var(--color-bg);
			}

			/*
			 * 桌面侧栏文章阅读退火（Dimming）：
			 * 仅在文章详情页向上/向下滚动进入正文阅读时生效；
			 * 滚动阅读时完全隐形（opacity: 0），彻底消除余光视觉干扰；
			 * 鼠标悬停到左侧轨道（hover）或键盘聚焦（focus-within）即时平滑唤醒。
			 */
			.rail--left[data-reading-fade="true"] {
				transition: opacity 350ms ease;
			}

			.rail--left[data-reading-fade="true"][data-dimmed="true"] {
				opacity: 0;
			}

			.rail--left[data-reading-fade="true"][data-dimmed="true"]:hover,
			.rail--left[data-reading-fade="true"][data-dimmed="true"]:focus-within {
				opacity: 1;
				transition: opacity var(--transition-fast) ease;
			}

			.rail-top {
				display: contents;
			}

			.rail-identity {
				order: 1;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				gap: var(--spacing-3);
				width: 100%;
				min-width: 0;
				padding-bottom: var(--spacing-4);
				border-bottom: 1px solid var(--color-border-subtle);
			}

			:global(.rail-identity-socials) {
				display: flex;
				justify-content: center;
				width: 100%;
			}

			.rail-menu {
				display: contents;
			}

			:global(.rail-menu > .rail-content) {
				order: 2;
				width: 100%;
				margin-top: var(--spacing-2);
			}

			:global(.rail-menu > .nav-admin) {
				order: 2;
			}

			.rail-bottom {
				display: contents;
			}

			.rail-search {
				order: 3;
				position: relative;
				display: flex;
				justify-content: flex-start;
				width: 100%;
				min-width: 0;
				margin-top: var(--spacing-4);
			}

			.rail-tools {
				order: 4;
				margin-top: var(--spacing-2);
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: flex-start;
				column-gap: var(--spacing-1);
				width: 100%;
			}

			:global(.rail-menu > .site-footer) {
				order: 5;
				width: 100%;
				margin-top: auto;
				padding-top: var(--spacing-3);
				border-top: 1px solid var(--color-border-subtle);
			}

			/* 汉堡：只在 <1000px 出现（左栏变横栏、菜单折叠时）。 */
			.nav-burger {
				display: none;
				align-items: center;
				justify-content: center;
				width: 38px;
				height: 38px;
				padding: 0;
				background: transparent;
				border: none;
				color: var(--color-text-secondary);
				cursor: pointer;
				border-radius: var(--radius);
				transition:
					color var(--transition-fast),
					background var(--transition-fast);
			}

			.nav-burger:hover,
			.nav-burger:focus-visible {
				color: var(--color-text);
				background: var(--color-surface);
			}

			.nav-burger-icon {
				width: 22px;
				height: 22px;
			}

			.nav-burger-icon--close {
				display: none;
			}

			.rail--left[data-nav-open="true"] .nav-burger-icon--menu {
				display: none;
			}

			.rail--left[data-nav-open="true"] .nav-burger-icon--close {
				display: block;
			}

			.nav-admin {
				display: block;
				margin-top: var(--spacing-3);
				padding: var(--spacing-3);
				border-top: 1px solid var(--color-border-subtle);
				font-size: var(--font-size-sm);
				color: var(--color-text-secondary);
				text-decoration: none;
				transition:
					color var(--transition-fast),
					background var(--transition-fast);
			}

			.nav-admin:hover,
			.nav-admin:focus-visible {
				color: var(--color-text);
				background: var(--color-surface);
				text-decoration: none;
			}

			/*
			 * 三栏外壳。宽度账（含滚动条槽位）：
			 * 200 + 24 + 680 + 24 + 200 = 1128，加两侧 padding 48 = 1176，
			 * 加滚动条 ≈ 1193 → 断点取 1200。
			 */
			.shell {
				display: grid;
				grid-template-columns:
					var(--rail-width) minmax(0, var(--content-width))
					var(--rail-width);
				gap: var(--spacing-6);
				justify-content: center;
				/* 固定左栏使用独立定位；网格其余轨道仍从 start 对齐。 */
				align-items: start;
				/*
				 * 左栏固定位置与外壳上边距一致；两个值都从 --shell-pad-top 推出，改一处即可。
				 *
				 * 页头取消后这里不再需要 + --nav-height；--nav-height 现在描述的是
				 * <1000px 那条贴顶横栏的高度（见媒体查询）。
				 */
				--shell-pad-top: var(--spacing-12);
				--rail-sticky-top: var(--shell-pad-top);
				/*
				 * 正文标题的锚点留白（scroll-margin-top）。桌面沿用左栏顶部位置，
				 * <1000px 则要额外让开贴顶横栏 —— 见下面对应的媒体查询。
				 * 自定义属性会继承到 .shell 里的标题上，所以页面样式直接用它。
				 */
				--shell-anchor-offset: 0px;
				padding: var(--shell-pad-top) var(--spacing-6) var(--spacing-16);
			}

			/*
			 * 左栏固定在视口；::before 保留网格第一列，因此正文与右栏仍按原列排布。
			 * 搜索下拉位于 rail-bottom，不受菜单滚动区域裁切；长菜单只在侧栏内部滚动。
			 */
			.shell::before {
				content: "";
				grid-column: 1;
				grid-row: 1;
			}

			.rail {
				align-self: start;
				position: sticky;
				top: var(--rail-sticky-top);
			}

			.rail--left {
				position: fixed;
				top: var(--rail-sticky-top);
				left: calc((100% - (var(--rail-width) + var(--rail-width) + var(--content-width) + var(--spacing-6) + var(--spacing-6) + var(--spacing-6) + var(--spacing-6))) / 2 + var(--spacing-6));
				width: var(--rail-width);
				height: calc(100vh - var(--rail-sticky-top));
				height: calc(100dvh - var(--rail-sticky-top));
				min-height: 0;
			}

			.shell-main {
				min-width: 0;
			}

			/*
			 * Search styling。
			 *
			 * 两条坑叠在一起，改这里之前先读这段：
			 *
			 * 1. `.site-search*` 是传给 LiveSearch 的 class，节点上带的是**子组件
			 *    的** scope 属性，所以必须 :global()，否则规则一条都不生效
			 *    （搜索结果下拉的定位就靠这里的 position: relative）。
			 *
			 * 2. 组件自带的 `.emdash-live-search-input` 规则带 [data-astro-cid-*]，
			 *    特异性 (0,2,0) 高于 :global(.class) 的 (0,1,0)。实测下来
			 *    padding / font-size / border-radius 三条全被组件赢走（组件值
			 *    分别是 0.5rem 1rem / 1rem / 0.25rem）—— 不写 !important 的话
			 *    这几行是**死代码**。下面只在「必须赢」的属性上加 !important，
			 *    其余照常写。
			 */
			:global(.site-search) {
				position: relative;
				width: 100%;
			}

			:global(.site-search-input) {
				/*
				 * 底色走组件自己的主题变量：组件把 background 写在它自己的规则里
				 * （带 [data-astro-cid-*]，特异性 (0,2,0) 压过这里的 (0,1,0)），
				 * 但它读的是 --emdash-search-bg —— 自定义属性在元素上直接赋值
				 * 就生效，不参与特异性比较，所以这一条不需要 !important。
				 */
				--emdash-search-bg: var(--color-surface);
				width: 100% !important;
				/* 剩下几条组件硬编码了值（0.5rem 1rem / 1rem / 0.25rem），
				   只能 !important 压过 */
				border: 0 !important;
				border-radius: var(--radius) !important;
				padding: var(--spacing-2) var(--spacing-3) !important;
				font-size: var(--font-size-sm) !important;
				font-family: var(--font-body);
				color: var(--color-text);
				transition: box-shadow var(--transition-fast);
			}

			:global(.site-search-input)::placeholder {
				color: var(--color-muted);
			}

			:global(.site-search-input):focus,
			:global(.site-search-input):focus-visible {
				outline: none;
				/* 没有边框了，焦点态就靠这圈 2px 的环 */
				box-shadow: 0 0 0 2px var(--color-brand);
			}

			:global(.site-search-results) {
				position: absolute;
				top: 100%;
				left: 0;
				right: auto !important;
				/*
				 * 搜索结果不再受输入框宽度限制：桌面左栏只有 200px，按输入框宽度
				 * 会把带摘要的结果挤成一列单字。
				 */
				width: max-content !important;
				min-width: 280px;
				max-width: min(360px, calc(100vw - var(--spacing-8)));
				margin-top: var(--spacing-2);
				background: var(--color-bg);
				border: 1px solid var(--color-border);
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-lg);
				max-height: 400px;
				overflow-y: auto;
				z-index: 1000;
			}

			:global(.site-search-results .emdash-live-search-loading),
			:global(.site-search-results .emdash-live-search-no-results) {
				padding: var(--spacing-4);
				text-align: center;
				color: var(--color-muted);
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result) {
				display: block;
				padding: var(--spacing-3) var(--spacing-4);
				text-decoration: none;
				color: var(--color-text);
				border-bottom: 1px solid var(--color-border-subtle);
				transition: background var(--transition-fast);
			}

			:global(.site-search-result):last-child {
				border-bottom: none;
			}

			:global(.site-search-result):hover,
			:global(.site-search-result):focus,
			:global(.site-search-result.focused) {
				background: var(--color-surface);
				outline: none;
			}

			:global(.site-search-result .emdash-live-search-result-title) {
				display: block;
				font-weight: 500;
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result .emdash-live-search-result-collection) {
				display: block;
				font-size: var(--font-size-xs);
				color: var(--color-muted);
				text-transform: uppercase;
				letter-spacing: var(--tracking-wide);
				margin-top: 2px;
			}

			:global(.site-search-result .emdash-live-search-result-snippet) {
				display: block;
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				margin-top: var(--spacing-1);
				line-height: var(--leading-snug);
			}

			:global(.site-search-result .emdash-live-search-result-snippet mark) {
				font-weight: 600;
				color: var(--color-text);
			}

			/* SiteFooter 位于左栏菜单的 flex 末尾，由组件自身的自动上边距推至栏底；不吸附视口。 */
			/*
			 * 三栏 → 两栏：视口装不下 200+680+200+gap+padding 时先收右栏。
			 * 左栏还在，中栏位置不变 —— 这正是「右栏留空不渲染」的延伸。
			 * 左栏保留，只调整网格列数，不改变中栏的列几何。
			 */
			@media (max-width: 1199px) {
				.shell {
					grid-template-columns: var(--rail-width) minmax(0, var(--content-width));
				}

				.rail--left {
					left: calc((100% - (var(--rail-width) + var(--content-width) + var(--spacing-6) + var(--spacing-6) + var(--spacing-6))) / 2 + var(--spacing-6));
				}

				.rail--right {
					display: none;
				}
			}

			/*
			 * 两栏也装不下 → 单栏。左栏不隐藏，而是**改排布**：同一份标记变成贴顶
			 * 横栏（品牌、搜索、外观控件和汉堡），菜单折进汉堡控制的面板。
			 * 横栏是 fixed，所以 .shell 的顶部内边距要额外让出它的高度。
			 */
			@media (max-width: 999px) {
				.rail--left[data-reading-fade="true"] {
					opacity: 1 !important;
					filter: none !important;
					transition: none;
				}

				.shell {
					grid-template-columns: minmax(0, var(--content-width));

					/* 只改 --shell-pad-top，桌面固定侧栏位置仍与外壳上边距一致 */
					--shell-pad-top: var(--spacing-8);
					--shell-anchor-offset: var(--nav-height);
					padding: calc(var(--nav-height) + var(--spacing-6)) var(--spacing-4)
						var(--spacing-12);
				}

				.shell::before {
					display: none;
				}

				.rail--left {
					position: fixed;
					top: 0;
					right: 0;
					left: 0;
					z-index: 100;
					display: grid;
					grid-template-areas: "identity search tools burger";
					grid-template-columns: auto minmax(0, 1fr) auto auto;
					grid-template-rows: var(--nav-height);
					width: auto;
					height: auto;
					column-gap: var(--spacing-1);
					row-gap: 0;
					align-items: center;
					min-height: 0;
					padding: 0 var(--spacing-4);
					background: color-mix(in srgb, var(--color-bg) 82%, transparent);
					backdrop-filter: blur(12px);
					-webkit-backdrop-filter: blur(12px);
					border-right: 0;
					border-bottom: 1px solid var(--color-border-subtle);
				}

				/* 让同一份身份与工具成为顶部栏的独立网格项。 */
				.rail-top,
				.rail-bottom {
					display: contents;
				}

				.rail-identity {
					grid-area: identity;
					order: unset;
					display: flex;
					flex-direction: row;
					align-items: center;
					justify-content: flex-start;
					gap: var(--spacing-2);
					padding-bottom: 0;
					border-bottom: none;
					width: auto;
					min-width: 0;
				}

				:global(.rail-identity-socials) {
					display: none !important;
				}

				.nav-burger {
					display: inline-flex;
					grid-area: burger;
					flex-shrink: 0;
				}

				.rail-search {
					grid-area: search;
					order: unset;
					margin-top: 0;
					width: auto;
					min-width: 0;
				}

				:global(.site-search) {
					flex: 1;
					min-width: 0;
					width: 100%;
					max-width: none;
				}

				:global(.site-search-input) {
					width: 100% !important;
				}

				:global(.site-search-results) {
					right: 0;
					width: auto;
					min-width: 0;
					max-width: none;
				}

				.rail-tools {
					grid-area: tools;
					order: unset;
					margin-top: 0;
					padding-top: 0;
					border-top: none;
					width: auto;
					flex-direction: row;
					justify-content: flex-end;
					gap: 0;
				}

				.rail-menu {
					display: none;
					order: unset;
					position: absolute;
					top: var(--nav-height);
					right: 0;
					left: 0;
					z-index: 1;
					flex-direction: column;
					align-items: center;
					justify-content: center;
					gap: var(--spacing-3);
					width: auto;
					height: calc(100vh - var(--nav-height));
					height: calc(100dvh - var(--nav-height));
					padding: var(--spacing-6) var(--spacing-4);
					overflow-y: auto;
					overscroll-behavior: contain;
					background: var(--color-bg);
					border-top: 1px solid var(--color-border-subtle);
					box-shadow: 0 10px 15px rgba(0, 0, 0, 0.12);
				}

				:global(.rail-menu > .rail-content) {
					order: unset;
					width: min(100%, 360px);
				}

				.nav-admin {
					order: unset;
					width: min(100%, 360px);
				}

				.rail--left[data-nav-open="true"] .rail-menu {
					display: flex;
				}

				/* 页脚是左栏的收尾分组，只有菜单展开时出现，顺序位于导航之后。 */
				:global(.rail-menu > .site-footer) {
					order: unset;
					margin-top: auto;
					padding-top: var(--spacing-3);
					border-top: 1px solid var(--color-border-subtle);
					width: min(100%, 360px);
				}
			}

			@media (max-width: 640px) {
				:global(.site-search-input) {
					padding: var(--spacing-1) var(--spacing-2) !important;
					font-size: var(--font-size-sm) !important;
				}
			}

			@media (max-width: 360px) {
				:global(.rail-identity .site-identity-name) {
					display: none;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.rail--left[data-reading-fade="true"] {
					transition: none !important;
				}
			}
		</style>

		<script>
			// 窄屏菜单：左栏在 <1000px 变成贴顶横栏，菜单由汉堡展开。
			// 与主题切换同一套 ClientRouter 规矩：每次导航后按钮是新节点，
			// 所以要在 astro:page-load 重绑，且用 onclick 赋值（不是
			// addEventListener）避免监听器叠加。
			//
			// 状态放在 <aside> 的 data-nav-open 上而不是菜单自己身上：
			// 展开/收起要同时驱动菜单与按钮的 aria-expanded，放在共同祖先上
			// 只有一个真源。
			function setupRailMenu() {
				const rail = document.querySelector<HTMLElement>(".rail--left");
				const btn = rail?.querySelector<HTMLButtonElement>("[data-nav-toggle]");
				if (!rail || !btn) return;

				const setOpen = (open: boolean) => {
					rail.dataset.navOpen = String(open);
					btn.setAttribute("aria-expanded", String(open));
					btn.setAttribute(
						"aria-label",
						open ? (btn.dataset.labelClose ?? "") : (btn.dataset.labelOpen ?? ""),
					);
				};

				// 整页加载与每次客户端导航后都回到收起态。
				setOpen(false);
				btn.onclick = () => setOpen(rail.dataset.navOpen !== "true");
			}

			setupRailMenu();
			document.addEventListener("astro:page-load", setupRailMenu);

			// 文章阅读侧栏退火：桌面端长文向下滚动后，左侧栏柔和变淡避免余光干扰；
			// 鼠标悬停（hover）或键盘聚焦（focus-within）即时恢复。
			let railFadeCleanup: (() => void) | null = null;

			function setupRailFade() {
				railFadeCleanup?.();
				railFadeCleanup = null;

				const rail = document.querySelector<HTMLElement>(
					".rail--left[data-reading-fade='true']",
				);
				if (!rail) return;

				let ticking = false;

				function update() {
					ticking = false;
					if (!window.matchMedia("(min-width: 1000px)").matches) {
						rail!.dataset.dimmed = "false";
						return;
					}
					const scrollY = window.scrollY || document.documentElement.scrollTop;
					const isDimmed = rail!.dataset.dimmed === "true";
					if (!isDimmed && scrollY > 120) {
						rail!.dataset.dimmed = "true";
					} else if (isDimmed && scrollY < 60) {
						rail!.dataset.dimmed = "false";
					}
				}

				function onScroll() {
					if (!ticking) {
						requestAnimationFrame(update);
						ticking = true;
					}
				}

				update();
				window.addEventListener("scroll", onScroll, { passive: true });
				window.addEventListener("resize", onScroll, { passive: true });

				railFadeCleanup = () => {
					window.removeEventListener("scroll", onScroll);
					window.removeEventListener("resize", onScroll);
				};
			}

			setupRailFade();
			document.addEventListener("astro:page-load", setupRailFade);
			document.addEventListener("astro:before-swap", () => {
				railFadeCleanup?.();
				railFadeCleanup = null;
			});
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
