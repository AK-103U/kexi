---
/**
 * 左栏内容：站点导航。
 *
 * 站主身份（头像 + 名字）不在这里 —— 它在页头的左侧，见 `SiteIdentity.astro`。
 * 两处共用同一条中轴：页头的头像与这里的导航链接都落在左栏的垂直中垂线上
 * （页头靠 `.nav-left` 的偏移对齐，见 `Base.astro`）。
 *
 * 只渲染内容，不渲染 `<aside>` —— 外层容器与 sticky 定位属于 `Base.astro`
 * 的三栏外壳。全站渲染，不只是文章页；窄屏由外壳整块隐藏，导航改走页头的
 * 汉堡抽屉，所以这里不需要自己的响应式逻辑。
 *
 * 当前页高亮：菜单项的 URL 自带语言前缀（en 菜单写 `/en/posts`），
 * 所以两边都过一遍 `stripLocale` 再比，`/en/posts` 与 `/posts` 就能对上。
 */
import { stripLocale } from "../i18n/ui";

interface MenuItem {
	label: string;
	url: string;
	target?: string | null;
}

interface Props {
	items: MenuItem[];
	/** 当前请求路径，用于高亮。 */
	pathname: string;
}

const { items, pathname } = Astro.props;

const current = stripLocale(pathname);

/** `/` 只做精确匹配，否则所有路径都会命中首页。 */
function isCurrent(url: string): boolean {
	const target = stripLocale(url);
	if (target === "/") return current === "/";
	return current === target || current.startsWith(`${target}/`);
}
---

<div class="rail-content">
	<nav class="rail-nav">
		<ul class="rail-nav-list">
			{
				items.map((item) => (
					<li>
						<a
							href={item.url}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							class:list={["rail-nav-link", { "is-current": isCurrent(item.url) }]}
							aria-current={isCurrent(item.url) ? "page" : undefined}
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</div>

<style>
	/*
	 * 容器层统一收口：左栏里的一切沿容器中垂线对齐。
	 * 放在这里而不是各子块上，是为了让「整条左栏一条中轴」这件事
	 * 只有一个声明处，加新块时自动跟随。
	 */
	.rail-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.rail-nav-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-1);
	}

	.rail-nav-link {
		display: block;
		padding: var(--spacing-1) 0;
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.rail-nav-link:hover {
		color: var(--color-text);
	}

	.rail-nav-link.is-current {
		color: var(--color-text);
		font-weight: 500;
	}
</style>
