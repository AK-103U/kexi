---
/**
 * 站主身份：头像 + 名字，作为侧栏品牌入口，也在窄屏顶部栏中保留。
 *
 * 两者横向排列并共用一条基线；长署名在左栏内截断，不溢入正文列。极窄屏
 * 由外壳隐藏名字、保留头像，给搜索输入框留出空间。
 *
 * 没有头像时回退到内置的默认头像 `public/default-avatar.webp`，
 * 站主可在后台为署名上传头像后自动切换。
 */
import { avatarUrl } from "../utils/media";

interface Props {
	displayName: string;
	avatarStorageKey?: string | null;
	avatarAlt?: string | null;
	/** 点击去向，通常是本站首页。 */
	href: string;
	class?: string;
}

const { displayName, avatarStorageKey, avatarAlt, href, class: className } = Astro.props;

// 有署名头像就用服务端裁剪后的 URL；否则回退到内置默认头像。
const DEFAULT_AVATAR_SRC = "/default-avatar.webp";
const avatarSrc = avatarStorageKey ? avatarUrl(avatarStorageKey, 96) : DEFAULT_AVATAR_SRC;
---

<a class:list={["site-identity", className]} href={href}>
	<img
		class="site-identity-avatar"
		src={avatarSrc}
		alt={avatarAlt || displayName}
		width="24"
		height="24"
		loading="eager"
	/>
	<span class="site-identity-name">{displayName}</span>
</a>

<style>
	.site-identity {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		width: 100%;
		min-width: 0;
		color: var(--color-text);
		text-decoration: none;
	}

	/* 小头像与站名组成紧凑的品牌标记。 */
	.site-identity-avatar {
		width: var(--avatar-size-md);
		height: var(--avatar-size-md);
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
		background: var(--color-surface);
	}

	.site-identity-name {
		min-width: 0;
		max-width: 100%;
		text-align: left;
		overflow: hidden;
		text-overflow: ellipsis;
		font-size: var(--font-size-sm);
		font-weight: 600;
		letter-spacing: var(--tracking-snug);
		line-height: var(--leading-snug);
		white-space: nowrap;
	}

	.site-identity:hover .site-identity-name {
		color: var(--color-brand);
	}
</style>
