---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	getTermsForEntries,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getReadingTime } from "../../utils/reading-time";
import { resolveEntryBylines, readEntryLocale } from "../../utils/bylines";
import { localePath, pageLang, useTranslations } from "../../i18n/ui";

interface Props {
	locale?: string;
}

const lang = pageLang(Astro.props, Astro);
const t = useTranslations(lang);

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("category", {
	locale: lang,
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	locale: lang,
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}

// Single batched query for tags on every post in this category, rather
// than calling getEntryTerms() per post (which would be one round-trip
// per post).
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
	{ locale: lang },
);

// 署名回退：非默认语言下补齐缺失语言行的人名与头像（见 utils/bylines.ts）。
// 归档页与首页一样渲染 PostCard，必须传入 bylines，否则卡片署名恒为空。
const bylinesByEntry = await resolveEntryBylines(
	"posts",
	posts.map((post) => ({
		id: post.data.id,
		locale: readEntryLocale(post.data, lang),
		bylines: post.data.bylines ?? [],
	})),
);
const filteredPosts = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
	bylines: bylinesByEntry.get(post.data.id) ?? [],
}));
---

<Base
	lang={lang}
	title={t("category.title", { name: term.label })}
	description={t("category.description", { name: term.label })}
>
	<section class="archive-section">
		<header class="archive-header">
			<span class="archive-label">{t("category.label")}</span>
			<h1 class="archive-title">{term.label}</h1>
		</header>

		{
			filteredPosts.length === 0 ? (
				<p class="no-posts">{t("category.empty")}</p>
			) : (
				<div class="posts-grid">
					{filteredPosts.map(({ post, tags, bylines }) => (
						<PostCard
							lang={lang}
							title={post.data.title}
							featuredImage={post.data.featured_image}
							href={localePath(lang, `/posts/${post.data.slug}`)}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							tags={tags.map((tag) => ({ slug: tag.slug, label: tag.label }))}
							bylines={bylines}
							edit={post.edit}
						/>
					))}
				</div>
			)
		}
		<nav class="pagination" aria-label={t("common.pagination")}>
			{
				cursor && (
					<a href={localePath(lang, `/category/${term.slug}`)}>
						{t("posts.firstPage")}
					</a>
				)
			}
			{
				nextCursor && (
					<a
						href={`${localePath(lang, `/category/${term.slug}`)}?cursor=${encodeURIComponent(nextCursor)}`}
					>
						{t("posts.nextPage")}
					</a>
				)
			}
		</nav>
	</section>
</Base>

<style>
	/* 列宽由 Base.astro 的三栏外壳接管 */
	.archive-section {
		min-width: 0;
	}

	.archive-header {
		margin-bottom: var(--spacing-12);
		padding-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.archive-label {
		display: block;
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-brand);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		margin-bottom: var(--spacing-2);
	}

	.archive-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	/* 中栏只有 680px，采用与 posts 一致的单列条目流排版 */
	.posts-grid {
		display: flex;
		flex-direction: column;
	}

	.no-posts {
		color: var(--color-muted);
	}
</style>
