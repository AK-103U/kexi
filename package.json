{
  "name": "kexi",
  "version": "0.1.0",
  "private": true,
  "description": "面向 Cloudflare 的 EmDash 博客主题，专注前台 UI、响应式布局和内容渲染。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "emdash": {
    "label": "Blog",
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "typecheck": "astro check",
    "types:worker": "wrangler types --include-runtime false",
    "check:spa": "node scripts/check-spa.mjs",
    "check:shell": "node scripts/check-shell.mjs"
  },
  "dependencies": {
    "@ak-103u/emdash-plugin-image-ratios": "file:..\\emdash-plugin-image-ratios",
    "@ak-103u/emdash-plugin-math": "^0.1.0",
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "^6.0.5",
    "@emdash-cms/cloudflare": "^1.2.0",
    "astro": "^7.3.2",
    "emdash": "^1.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/node": "^26.6.5",
    "playwright-core": "^1.63.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
